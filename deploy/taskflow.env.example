# Variables d'environnement de production (copier en /opt/taskflow/taskflow.env et adapter)
DB_USER=taskflow
DB_PASSWORD=change_moi
# Generer une cle : openssl rand -base64 48
JWT_SECRET=REMPLACER_PAR_UNE_CLE_BASE64_DE_48_OCTETS
# Front servi par le jar : meme origine. Ajouter le domaine si besoin.
CORS_ORIGINS=http://VOTRE_IP_OU_DOMAINE:8080
ADMIN_EMAIL=votre.email@gmail.com
ADMIN_PASSWORD=MotDePasseAdminSolide
MAIL_ENABLED=true
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=mot_de_passe_application_gmail
