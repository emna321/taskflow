    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "collabToken",
      "value": ""
    },
    {
      "key": "collabEmail",
      "value": "sami.collab@taskflow.com"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "projetId",
      "value": ""
    },
    {
      "key": "tacheId",
      "value": ""
    },
    {
      "key": "collabId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "tacheAutre",
      "value": ""
