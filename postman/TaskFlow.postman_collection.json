  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Register collaborateur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{collabEmail}}\",\n  \"password\": \"secret123\",\n  \"tel\": \"22123456\",\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Sami\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 ou 409 (deja inscrit)\", () => pm.expect([201,409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) { pm.test(\"Role COLLABORATEUR\", () => pm.expect(pm.response.json().roles).to.eql([\"COLLABORATEUR\"])); pm.test(\"Pas de mot de passe renvoye\", () => pm.expect(pm.response.json().password).to.be.undefined); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - email deja utilise (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{collabEmail}}\",\n  \"password\": \"secret123\",\n  \"nom\": \"X\",\n  \"prenom\": \"Y\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - donnees invalides (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pas-un-email\",\n  \"password\": \"123\",\n  \"nom\": \"\",\n  \"prenom\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Erreurs par champ\", () => pm.expect(pm.response.json().details).to.have.property(\"email\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
