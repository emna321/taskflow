@startuml TaskFlow
skinparam classAttributeIconSize 0
title TaskFlow - Diagramme de classes

enum RoleName { ADMIN\nCOLLABORATEUR }
enum Statut { A_FAIRE\nEN_COURS\nTERMINEE }
enum Priorite { BASSE\nMOYENNE\nHAUTE }

class User {
  - id : Long
  - email : String
  - password : String  <<BCrypt>>
  - tel : String
  - nom : String
  - prenom : String
}
class Role {
  - id : Long
  - libelle : RoleName
}
class Client {
  - id : Long
  - nom : String
  - tel : String
  - email : String
  - adresse : String
}
class Projet {
  - id : Long
  - libelle : String
  - budget : Double
  - duree : Integer
  - description : String
}
class Tache {
  - id : Long
  - titre : String
  - description : String
  - statut : Statut
  - priorite : Priorite
  - dateEcheance : LocalDate
}

User "*" -- "*" Role : possede >
Client "1" -- "*" Projet : a >
Projet "1" -- "*" Tache : contient >
User "0..1" -- "*" Tache : est affecte a <
Role ..> RoleName
Tache ..> Statut
Tache ..> Priorite
@enduml
