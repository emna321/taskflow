@startuml TaskFlow
skinparam classAttributeIconSize 0
title TaskFlow - Diagramme de classes

enum RoleName { ADMIN\nCOLLABORATEUR }
enum Statut { A_FAIRE\nEN_COURS\nTERMINEE }
enum Priorite { BASSE\nMOYENNE\nHAUTE }

class User {
  - id : Long
  - email : String
  - password : String  <<BCrypt>>
  - tel : String
  - nom : String
  - prenom : String
  - photoContenu : byte[]  <<LONGBLOB/bytea>>
  - photoTypeMime : String
}
class Role {
  - id : Long
  - libelle : RoleName
}
class Client {
  - id : Long
  - nom : String
  - tel : String
  - email : String
  - adresse : String
  - logoContenu : byte[]  <<LONGBLOB/bytea>>
  - logoTypeMime : String
}
class Projet {
  - id : Long
  - libelle : String
  - budget : Double
  - duree : Integer
  - description : String
}
class Tache {
  - id : Long
  - titre : String
  - description : String
  - statut : Statut
  - priorite : Priorite
  - dateEcheance : LocalDate
}
class Fichier {
  - id : Long
  - nomOriginal : String
  - typeMime : String
  - taille : Long
  - contenu : byte[]  <<LONGBLOB/bytea>>
  - dateUpload : LocalDateTime
}
class Commentaire {
  - id : Long
  - texte : String
  - dateCreation : LocalDateTime
}

User "*" -- "*" Role : possede >
Client "1" -- "*" Projet : a >
Projet "1" -- "*" Tache : contient >
User "0..1" -- "*" Tache : est affecte a <
Role ..> RoleName
Tache ..> Statut
Tache ..> Priorite
Fichier "*" -- "1" User : envoye par >
Fichier "*" -- "0..1" Tache : piece jointe de >
Fichier "*" -- "0..1" Projet : document de >
Commentaire "*" -- "1" User : ecrit par >
Commentaire "*" -- "1" Tache : commente >
note right of Fichier
  Rattache a une Tache OU un Projet
  (jamais les deux), verifie en service.
end note
@enduml
